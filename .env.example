# ── V.A.U.L.T. / Jarvis configuration ─────────────────────────────────────────
# Copy this file to .env (same folder) and fill in ONE provider.

# 1) Google Gemini — FREE tier, no credit card. Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides (defaults: gemini-3.5-flash / gemini-3.5-flash-lite)
# JARVIS_MODEL=gemini-3.5-flash
# JARVIS_FAST_MODEL=gemini-3.5-flash-lite

# 2) Any other OpenAI-compatible provider — uncomment one block instead.
# JARVIS_PROVIDER=groq        # free tier: https://console.groq.com/keys
# GROQ_API_KEY=
# JARVIS_MODEL=<a Groq model that supports tool use>

# JARVIS_PROVIDER=openrouter  # many free models: https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# JARVIS_MODEL=<model id, e.g. one ending in :free>

# JARVIS_PROVIDER=ollama      # fully local & free: https://ollama.com
# JARVIS_MODEL=<a local model with tool calling, e.g. qwen3>

# JARVIS_PROVIDER=openai
# OPENAI_API_KEY=
# JARVIS_MODEL=

# JARVIS_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# JARVIS_MODEL=

# JARVIS_BASE_URL=            # any other OpenAI-compatible endpoint (+ JARVIS_API_KEY, JARVIS_MODEL)

# Use the Claude Code CLI instead of the built-in agent:
# JARVIS_AGENT=claude

# ── You ──────────────────────────────────────────────────────────────────────
# (or set these in the HUD / Obsidian plugin settings — saved to .claude/jarvis.json)
# JARVIS_OWNER_NAME=Boss
# JARVIS_OWNER_PRONOUN=they       # he | she | they
# JARVIS_CURRICULUM=IB            # IB | AP | A-Level | GCSE | …

# ── Gmail + Google Calendar (optional, works with ANY model) ─────────────────
# Your own free OAuth client (type "Desktop app") — README → Gmail & Calendar. Then: npm run google:auth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────
# Better web search than the keyless DuckDuckGo fallback (both have free tiers):
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# Premium voice (otherwise free Microsoft Edge neural voices / browser voices):
# ELEVENLABS_API_KEY=
# ELEVEN_VOICE_ID=
# Server port (default 3333) and phone-access key (default: random each start)
# PORT=3333
# JARVIS_KEY=
# Vault location if .claude/ is not inside your vault
# JARVIS_VAULT=~/Documents/MyVault
# Let the agent write to every granted folder (not recommended)
# JARVIS_FULL=1
